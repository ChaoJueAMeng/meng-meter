{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meng meter",
  "version": "0.3.0",
  "identifier": "com.meng.meter",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Meng meter",
        "width": 227,
        "height": 67,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "settings",
        "title": "Meng meter",
        "url": "settings.html",
        "width": 400,
        "height": 640,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "center": true,
        "visible": false,
        "focus": false,
        "theme": "Light",
        "backgroundColor": "#f7fbff"
      },
      {
        "label": "overlay-cpu",
        "title": "CPU",
        "url": "overlay.html?kind=cpu",
        "width": 128,
        "height": 72,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "overlay-gpu",
        "title": "GPU",
        "url": "overlay.html?kind=gpu",
        "width": 128,
        "height": 72,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "overlay-fps",
        "title": "FPS",
        "url": "overlay.html?kind=fps",
        "width": 128,
        "height": 72,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "layout-lock",
        "title": "锁定布局",
        "url": "layout-lock.html",
        "width": 168,
        "height": 64,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Meng",
    "shortDescription": "内存占用与网速悬浮球",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
